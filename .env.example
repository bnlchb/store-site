# ==========================================================
# ENSA OFFLINE / Originalfit — Environment template
# Copy this file to ".env" (production/deploy) or ".env.local"
# (local dev) and fill in the real values. Never commit the
# filled files — they are excluded via .gitignore.
# ==========================================================

# --- Supabase (PostgreSQL) ---
# Values from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# service_role key: required for admin writes (bypasses RLS). Keep secret!
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (image upload / storage) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Admin dashboard login (/admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=a-strong-password

# --- Optional / public site config ---
# NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
