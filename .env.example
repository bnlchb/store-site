# ==========================================================
# ENSA OFFLINE — Environment template
# Copy this file to ".env" (production/deploy) or ".env.local"
# (local dev) and fill in the real values. Never commit the
# filled files — they are excluded via .gitignore.
# ==========================================================

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE
MONGODB_DB=ensaoffline

# --- Cloudinary (image upload / storage) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Admin dashboard login (/admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=a-strong-password

# --- Optional / public site config ---
# NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
